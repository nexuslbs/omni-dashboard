# omni-dashboard - local environment template (code-plan C9 never-commit guardrail)
#
# Copy this file to `.env` (gitignored) and fill in REAL values for local
# development. NEVER commit `.env` or any file holding live secrets - the
# pre-commit hook and CI job (scripts/secret-scan.py) block them.
#
# All values below are placeholders (xxxx). Replace every xxxx before use.
VITE_API_BASE_URL=http://localhost:8080
SERVER_PORT=3001
AUTH_SECRET=xxxx-generate-with-openssl-rand-hex-32
